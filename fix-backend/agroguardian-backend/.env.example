# ─── Server ───────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────
MONGO_URI=mongodb://localhost:27017/agroguardian
# For MongoDB Atlas (cloud):
# MONGO_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/agroguardian

# ─── JWT ──────────────────────────────────
JWT_SECRET=agroguardian_super_secret_key_2026
JWT_EXPIRES_IN=7d

# ─── Frontend URL (for CORS) ───────────────
CLIENT_URL=http://127.0.0.1:5500

# ─── Disease AI (mock or real model URL) ──
AI_MODEL_URL=http://localhost:8000/predict

# ─── Market Data (AGMARKNET API key) ──────
AGMARKNET_API_KEY=your_api_key_here
